{
    "manifest_version": 3,
    "name": "Reels & Shorts Blocker",
    "version": "1.1.5",
    "description": "Blocks YouTube Shorts and Instagram Reels",
    "permissions": [
      "declarativeNetRequest",
      "declarativeNetRequestWithHostAccess",
      "storage",
      "scripting"
    ],
    "host_permissions": [
      "*://www.youtube.com/*",
      "*://www.instagram.com/*"
    ],
    "background": {
      "service_worker": "background.js"
    },

    
   "action": {
  "default_popup": "popup.html",
  "default_title": "Toggle Reels/Shorts Blocker",
  "default_icon": {
    "16": "Logo.png",
    "48": "Logo.png",
    "128": "Logo.png"
  }
},
"icons": {
  "16": "Logo.png",
  "48": "Logo.png",
  "128": "Logo.png"
},


    "declarative_net_request": {
      "rule_resources": [
        {
          "id": "ruleset_1",
          "enabled": true,
          "path": "rules.json"
        }
      ]
    },
    "content_scripts": [
      {
        "matches": [
          "*://www.youtube.com/*",
          "*://www.instagram.com/*"
        ],
        "js": ["content.js"],
        "run_at": "document_end"
      }
    ]
  }
  